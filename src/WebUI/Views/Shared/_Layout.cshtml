<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portal de Reclamaciones y Auditoría</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebUI.styles.css" asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100 bg-light text-dark">
    <!-- Cinta superior de contexto asegurador -->
    <div class="bg-dark text-white-50 small py-1 border-bottom border-secondary">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span><strong class="text-white">Audita tus reclamaciones:</strong> registro transparente, trazabilidad y
                control documental.</span>
                <span class="d-none d-md-inline">Gestión de Siniestros y Reclamaciones</span>
            </div>
        </div>

        <header>
            <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm mb-4">
                <div class="container">
                    <a class="navbar-brand fw-bold text-primary d-flex align-items-center gap-2" asp-area=""
                       asp-controller="Home" asp-action="Index">
                        <span
                        class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">SG-R</span>
                        <span>SegurosAudit</span>
                    </a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                            aria-controls="mainNavbar" aria-expanded="false" aria-label="Alternar navegación">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="mainNavbar">
                        @* <ul class="navbar-nav me-auto mb-2 mb-sm-0">
                            <li class="nav-item">
                                <a class="nav-link fw-semibold text-dark px-3" asp-area="" asp-controller="Radicar"
                                   asp-action="Index">
                                    Radicar reclamación
                                </a>
                            </li>
                        </ul> *@

                        <ul class="navbar-nav ms-auto align-items-sm-center gap-2">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-medium" asp-controller="Panel" asp-action="Index">
                                        Panel de auditoría
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <form asp-controller="Cuenta" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-secondary btn-sm px-3">
                                            Salir
                                        </button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link fw-semibold text-dark px-3" asp-area="" asp-controller="Radicar"
                                       asp-action="Index">
                                        Radicar reclamación
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="btn btn-outline-primary btn-sm px-3 fw-medium" asp-controller="Cuenta"
                                       asp-action="Login">
                                        Acceso Analista
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <div class="container flex-grow-1">
            <main role="main" class="pb-4">
                @RenderBody()
            </main>
        </div>

        <footer class="bg-white border-top py-3 mt-auto text-muted small">
            <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span>&copy; 2026 - SegurosAudit · Plataforma de Reclamaciones y Auditoría</span>
                <span>Atención y control de reclamaciones</span>
            </div>
        </footer>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>