@model Common.Dto.RadicarResultado
@{
    ViewData["Title"] = "Reclamación recibida";
}

<div class="container py-4" style="max-width: 700px;">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5">
            <!-- Encabezado de confirmación -->
            <div class="d-flex align-items-start gap-3 pb-4 border-bottom">
                <span class="badge rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center flex-shrink-0"
                      style="width: 42px; height: 42px; font-size: 1.15rem;">
                    ✓
                </span>
                <div>
                    <span class="text-uppercase text-success fw-semibold small">
                        Radicación registrada
                    </span>
                    <h1 class="h4 fw-bold text-dark mt-1 mb-1">Reclamación recibida</h1>
                    <p class="text-muted mb-0">@Model.Mensaje</p>
                </div>
            </div>

            <!-- Número de seguimiento / Token -->
            <div class="bg-light border rounded p-4 my-4">
                <div class="small text-muted fw-medium mb-1">
                    Número de seguimiento de su reclamación
                </div>
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <code id="tokenSeguimiento" class="fs-5 fw-bold text-primary user-select-all">
                        @Model.PublicToken
                    </code>
                    <button type="button" id="btnCopiarToken" class="btn btn-outline-secondary btn-sm">
                        Copiar código
                    </button>
                </div>
                <div id="mensajeCopiado" class="small text-success mt-2 d-none">
                    Código copiado al portapapeles.
                </div>
            </div>

             <!-- Comprobante por correo -->
            <div class="alert alert-light border d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4" role="alert">
                <div>
                    <div class="fw-semibold small">Confirmación enviada a su correo</div>
                    <div class="text-muted small">
                        @if (!string.IsNullOrWhiteSpace(Model.Correo))
                        {
                            <span>Enviamos el comprobante de radicación a <strong>@Model.Correo</strong>.</span>
                        }
                        else
                        {
                            <span>No registramos un correo para este radicado.</span>
                        }
                    </div>
                </div>
            </div>

            <!-- Activación opcional de Telegram -->
            @if (!string.IsNullOrWhiteSpace(Model.TelegramLink))
            {
                <div class="card border-0 bg-light rounded mb-4">
                    <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div>
                            <div class="fw-semibold small">¿Quiere avisos por Telegram?</div>
                            <div class="text-muted small">
                                Es opcional: puede seguir consultando con su número de seguimiento.
                            </div>
                        </div>
                        <a class="btn btn-outline-primary btn-sm" href="@Model.TelegramLink"
                           target="_blank" rel="noopener">
                            Activar Telegram (opcional)
                        </a>
                    </div>
                </div>
            }
            <!-- Orientación rápida -->
            <p class="small text-muted mb-4">
                Conserve este número de seguimiento para consultar el estado de su expediente,
                verificar la validación de documentos o enviar soportes complementarios.
            </p>

            <!-- Acciones -->
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Index" class="btn btn-primary px-4 fw-semibold">
                    Radicar otra reclamación
                </a>
                <a asp-controller="Seguimiento" asp-action="Index" asp-route-token="@Model.PublicToken" class="btn btn-outline-primary px-4">
                    Consultar estado ahora
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const btnCopiar = document.getElementById("btnCopiarToken");
            const tokenEl = document.getElementById("tokenSeguimiento");
            const msgCopiado = document.getElementById("mensajeCopiado");

            if (!btnCopiar || !tokenEl) return;

            btnCopiar.addEventListener("click", async function () {
                const texto = tokenEl.textContent.trim();
                try {
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        await navigator.clipboard.writeText(texto);
                    } else {
                        const aux = document.createElement("textarea");
                        aux.value = texto;
                        document.body.appendChild(aux);
                        aux.select();
                        document.execCommand("copy");
                        document.body.removeChild(aux);
                    }
                    if (msgCopiado) {
                        msgCopiado.classList.remove("d-none");
                        setTimeout(() => msgCopiado.classList.add("d-none"), 2500);
                    }
                } catch {
                    // Si el navegador bloquea el portapapeles, el texto sigue siendo seleccionable
                }
            });
        })();
    </script>
}